+/// AirFrameXR (tools/patches/headset-view-message.patch): the one JSON line the host wants every connected client to have
+/// (`{"airframexr":1,"view":{...}}`, docs/PICTURE_EDGES_DESIGN.md section 8), sent as `ServerControlPacket::Reserved` right after the stream starts and
+/// again whenever it changes. None = nothing to send.
+pub static HEADSET_VIEW_MESSAGE: Mutex<Option<String>> = Mutex::new(None);
+
+pub fn set_headset_view_message(message: Option<String>) {
+    *HEADSET_VIEW_MESSAGE.lock() = message;
+}
+
 pub fn settings() -> Settings {
     SESSION_MANAGER.read().settings().clone()
 }
