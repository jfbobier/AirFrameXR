<?xml version="1.0" encoding="utf-8"?>
<!-- Copied next to every GUI exe as <exe>.config (tools/remote/stage13_package.ps1). WinForms' own per-monitor DPI support (.NET Framework 4.7+):
     the process is PerMonitorV2 aware, DeviceDpi is the window's monitor, a window moved to another monitor is rescaled by the framework.
     Needs the TargetFramework assembly attribute (Common.cs) and no DPI entry in the manifest. -->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2"/>
  </System.Windows.Forms.ApplicationConfigurationSection>
</configuration>
