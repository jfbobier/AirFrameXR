  "reconnect_storm": {
   "description": "The headset comes and goes: 15 client sessions of 8-25 s with 1-6 s between them against one daemon host while the app runs, generation on, and every client behaving like the visionOS one (tracking only after 30 frames have arrived). Each session must stream, the first frame within 6 s of connecting; each new session also restarts the client clock.",
   "override": {
    "host": {
     "daemon": true,
     "seconds": 400,
     "exit_after_frames": 10000000
    },
    "client": {
     "no_stream_dump": true,
     "track_after_frame": true,
     "track_frames_needed": 30,
     "seconds": 30
    },
    "app": {
     "frames": 1000000,
     "timeout_s": 260
    },
    "reconnect_storm": {
     "count": 15,
     "on_s": [
      8,
      25
     ],
     "gap_s": [
      1,
      6
     ],
     "seed": 11
    },
    "timeout_s": 480
   },
   "criteria": {
