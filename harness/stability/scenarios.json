  "tracking_blackout_frame": {
   "description": "AVP behaviour: the pose uplink goes silent for 5 s at +30 s and resumes only once a frame arrives. The gears 2026-10-20 stall: generation on must keep sending frames (the last pose) so the client resumes.",
   "override": {
    "client": {
     "track_blackout": "30:5:frame",
     "track_after_frame": true,
     "track_frames_needed": 30
    }
   },
   "criteria": {
    "warmup_s": 15,
    "max_stall_ms": 1500,
    "blackouts_resume": true,
    "min_fps_during_blackout": 20,
    "max_recovery_s": 2,
    "alive_at_end_s": 3,
    "host_memory_events": 2
   }
  },
  "tracking_blackout_frame_fgoff": {
   "description": "The same with generation off: the control (the shim repeats the last pose after 3 ms, frames keep flowing), must pass today.",
   "override": {
    "host": {
     "frame_gen": null
    },
    "client": {
     "track_blackout": "30:5:frame",
     "track_after_frame": true,
