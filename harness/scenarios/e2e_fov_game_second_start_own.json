{
  "description": "The restriction policy (owner, 2026-11-06), a game that draws its own frustum (Uncharted community VR, Luke Ross's mods): nobody is trusted. It is told V at its first start, where its own union frustum already shows (`own_frustum`), and V again at the next start.",
  "topology": {
    "host": "builder",
    "client": "builder",
    "client_bind_ip": "127.0.0.2",
    "host_launch": "interactive"
  },
  "session_overrides": {
    "session_settings.video.foveated_encoding.enabled": false,
    "openvr_config.enable_foveated_encoding": false,
    "openvr_config.eye_resolution_width": 1760,
    "openvr_config.eye_resolution_height": 1600,
    "openvr_config.target_eye_resolution_width": 1760,
    "openvr_config.target_eye_resolution_height": 1600,
    "session_settings.connection.client_recv_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.connection.server_send_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.video.transcoding_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    },
    "session_settings.video.emulated_headset_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    }
  },
  "host": {
    "shim": true,
    "fps": 90,
    "seconds": 150,
    "connect_timeout": 45,
    "gpu_keepalive": 90,
    "fov_scale": "80,80,80,80",
    "fov_whitelist": []
  },
  "client": {
    "seconds": 140,
    "connect_timeout": 45,
    "yaw_amp": 0.5,
    "yaw_hz": 0.25,
    "views_tan": "1.732,1.0,1.192,1.0"
  },
  "client_env": {
    "RUST_LOG": "warn"
  },
  "app": {
    "frames": 600,
    "timeout_s": 60,
    "env": {
      "XR_PROBE_RENDER_SIZE": "2160x2160",
      "XR_PROBE_SUBMIT_FOV": "union"
    },
    "then": [
      {
        "exe": "xr_probe",
        "after_s": 25,
        "frames": 600,
        "timeout_s": 60,
        "env": {
          "XR_PROBE_RENDER_SIZE": "2160x2160",
          "XR_PROBE_SUBMIT_FOV": "union"
        }
      }
    ]
  },
  "gpu_sample": true,
  "timeout_s": 330,
  "checks": {
    "host_min_frames": 250,
    "client_min_frames": 200,
    "max_duplicate_timestamps": 400,
    "min_delivery_ratio": 0.7,
    "codec": "Hevc",
    "stream": {
      "codec_name": "hevc",
      "profile": "Main 10",
      "pix_fmt": "yuv420p10le",
      "width": 3520,
      "height": 1600,
      "color_range": "pc"
    },
    "decode": true,
    "decode_frame_slack": 40,
    "app_min_frames": 300,
    "refresh_hz": 90,
    "fov_restrict": {
      "scale": [
        100,
        100,
        100,
        100
      ],
      "tol": 0.002,
      "truth": "union of both eyes + fixed square size (Uncharted community VR)",
      "starts": [
        {
          "verdict": "own_frustum",
          "unrestricted": true
        },
        {
          "verdict": "own_frustum",
          "unrestricted": true
        }
      ]
    },
    "timestamps_monotonic": false
  }
}
