{
  "description": "The desktop mirror for a left-handed user: the mock headset presses the LEFT trigger every 4 s and then keeps the right controller quiet (MOCK_HAND_SCRIPT=left). The app must hand the beam to the left controller (logged, never taken back) and keep drawing the beam and pointing at the screen with it; the click timing checks of e2e_mirror do not apply (the right controller is quiet). Synthetic desktop.",
  "topology": {
    "host": "builder",
    "client": "builder",
    "client_bind_ip": "127.0.0.2",
    "host_launch": "interactive"
  },
  "session_overrides": {
    "session_settings.video.foveated_encoding.enabled": false,
    "openvr_config.enable_foveated_encoding": false,
    "openvr_config.eye_resolution_width": 1760,
    "openvr_config.eye_resolution_height": 1600,
    "openvr_config.target_eye_resolution_width": 1760,
    "openvr_config.target_eye_resolution_height": 1600,
    "session_settings.connection.client_recv_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.connection.server_send_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.video.transcoding_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    },
    "session_settings.video.emulated_headset_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    }
  },
  "host": {
    "shim": true,
    "fps": 90,
    "seconds": 60,
    "connect_timeout": 45,
    "gpu_keepalive": 90,
    "exit_after_frames": 1500
  },
  "client": {
    "seconds": 55,
    "connect_timeout": 45,
    "yaw_amp": 0,
    "controllers": true
  },
  "client_env": {
    "RUST_LOG": "warn",
    "MOCK_HAND_YAW_DEG": "0",
    "MOCK_HAND_PITCH_DEG": "45",
    "MOCK_HAND_SCRIPT": "left"
  },
  "app": {
    "exe": "mirrordesktop",
    "seconds": 30,
    "timeout_s": 90,
    "synthetic": true
  },
  "gpu_sample": true,
  "timeout_s": 240,
  "checks": {
    "max_duplicate_timestamps": 400,
    "min_delivery_ratio": 0.5,
    "codec": "Hevc",
    "stream": {
      "codec_name": "hevc",
      "profile": "Main 10",
      "pix_fmt": "yuv420p10le",
      "width": 3520,
      "height": 1600,
      "color_range": "pc"
    },
    "decode": true,
    "decode_frame_slack": 80,
    "refresh_hz": 90,
    "mirror": {
      "min_frames": 20,
      "min_ok_frac": 0.9,
      "beam": true,
      "clicks": false,
      "max_latency_ms": 150,
      "perf": {
        "min_fps": 80,
        "max_picture_ms": 4.0
      },
      "left_hand": true
    },
    "timestamps_monotonic": false
  }
}
