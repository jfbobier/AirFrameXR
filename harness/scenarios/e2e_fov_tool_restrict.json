{
  "description": "The restriction tool (section 6b): the probe's `restrict` scene (the benchmark scene inside the box, black outside) with scripted keys: Space starts, two Left pull the outer edges in 2 degrees on both eyes, Down the lower ones 1, Shift+Left pushes the outer back 1, Tab goes to the left eye alone and Right pulls its inner edge, Space held shows the whole view, Enter keeps it. Checked: the JSON lines equal the keys, the scene is lit inside the box and black outside in the decoded stream, and the whole view while Space is held.",
  "topology": {
    "host": "builder",
    "client": "builder",
    "client_bind_ip": "127.0.0.2",
    "host_launch": "interactive"
  },
  "session_overrides": {
    "session_settings.video.foveated_encoding.enabled": false,
    "openvr_config.enable_foveated_encoding": false,
    "openvr_config.eye_resolution_width": 1760,
    "openvr_config.eye_resolution_height": 1600,
    "openvr_config.target_eye_resolution_width": 1760,
    "openvr_config.target_eye_resolution_height": 1600,
    "session_settings.connection.client_recv_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.connection.server_send_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.video.transcoding_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    },
    "session_settings.video.emulated_headset_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    }
  },
  "host": {
    "shim": true,
    "fps": 90,
    "seconds": 60,
    "connect_timeout": 45,
    "gpu_keepalive": 90,
    "exit_after_frames": 700,
    "gui": true
  },
  "client": {
    "seconds": 55,
    "connect_timeout": 45,
    "yaw_amp": 0.5,
    "yaw_hz": 0.25,
    "views_tan": "1.732,1.0,1.192,1.0"
  },
  "client_env": {
    "RUST_LOG": "warn"
  },
  "app": {
    "frames": 1400,
    "timeout_s": 60,
    "env": {
      "XR_PROBE_TOOL": "restrict",
      "XR_PROBE_SCENE": "bench\\littlest_tokyo.vab",
      "XR_PROBE_SOUND": "0",
      "XR_PROBE_KEYS": "120:space,150:left,154:left,170:down,190:shift+left,210:tab,230:right,260:+space,290:-space,320:enter"
    }
  },
  "gpu_sample": true,
  "timeout_s": 240,
  "checks": {
    "host_min_frames": 800,
    "client_min_frames": 700,
    "timestamps_monotonic": true,
    "max_duplicate_timestamps": 400,
    "min_delivery_ratio": 0.7,
    "codec": "Hevc",
    "stream": {
      "codec_name": "hevc",
      "profile": "Main 10",
      "pix_fmt": "yuv420p10le",
      "width": 3520,
      "height": 1600,
      "color_range": "pc"
    },
    "decode": true,
    "refresh_hz": 90,
    "max_pipeline_latency_ms": 150,
    "decode_frame_slack": 60,
    "tool": {
      "mode": "restrict",
      "expect": {
        "start": 1.0,
        "deltas": [
          [
            -1.0,
            -1.0,
            0.0,
            -1.0
          ],
          [
            -1.0,
            0.0,
            0.0,
            -1.0
          ]
        ]
      },
      "samples": [
        {
          "app_frame": 200,
          "what": "both_eyes",
          "restrict_eyes": [
            0,
            1
          ]
        },
        {
          "app_frame": 250,
          "what": "left_alone",
          "restrict_eyes": [
            0,
            1
          ]
        },
        {
          "app_frame": 275,
          "what": "whole_view",
          "whole_view": true,
          "restrict_eyes": [
            0,
            1
          ]
        }
      ]
    }
  }
}
