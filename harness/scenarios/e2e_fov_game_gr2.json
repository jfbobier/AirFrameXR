{
  "description": "Game behaviours for the FOV-restriction intake (docs/PICTURE_EDGES_DESIGN.md section 7): the mock declares Apple's frustum, stream 1760x1600 per eye. Modelled on our Gravity Rush 2 mod (flat2vrharness patches/0020 :1167, :1985; gr2vr.json resolution 2160 = 3840x2160 per eye, alternate-eye stereo at 60 fps): the largest half-tangent over both eyes and all edges as a SYMMETRIC frustum for both eyes, at a fixed 16:9 size. Told the author's fit it submits 0.97 / 0.97 / 0.69 / 0.69: larger than told on the inner and lower edges, nothing saved (-195 %). The host must say own frustum.",
  "topology": {
    "host": "builder",
    "client": "builder",
    "client_bind_ip": "127.0.0.2",
    "host_launch": "interactive"
  },
  "session_overrides": {
    "session_settings.video.foveated_encoding.enabled": false,
    "openvr_config.enable_foveated_encoding": false,
    "openvr_config.eye_resolution_width": 1760,
    "openvr_config.eye_resolution_height": 1600,
    "openvr_config.target_eye_resolution_width": 1760,
    "openvr_config.target_eye_resolution_height": 1600,
    "session_settings.connection.client_recv_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.connection.server_send_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.video.transcoding_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    },
    "session_settings.video.emulated_headset_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    }
  },
  "host": {
    "shim": true,
    "fps": 90,
    "seconds": 60,
    "connect_timeout": 45,
    "gpu_keepalive": 90,
    "exit_after_frames": 420,
    "fov_override": "0.97,0.71,0.69,0.63"
  },
  "client": {
    "seconds": 55,
    "connect_timeout": 45,
    "yaw_amp": 0.5,
    "yaw_hz": 0.25,
    "views_tan": "1.732,1.0,1.192,1.0"
  },
  "client_env": {
    "RUST_LOG": "warn"
  },
  "app": {
    "frames": 420,
    "timeout_s": 60,
    "env": {
      "XR_PROBE_RENDER_SIZE": "3840x2160",
      "XR_PROBE_SUBMIT_FOV": "symmetric"
    }
  },
  "gpu_sample": true,
  "timeout_s": 200,
  "checks": {
    "host_min_frames": 250,
    "client_min_frames": 200,
    "max_duplicate_timestamps": 400,
    "min_delivery_ratio": 0.7,
    "codec": "Hevc",
    "stream": {
      "codec_name": "hevc",
      "profile": "Main 10",
      "pix_fmt": "yuv420p10le",
      "width": 3520,
      "height": 1600,
      "color_range": "pc"
    },
    "decode": true,
    "decode_frame_slack": 40,
    "app_min_frames": 300,
    "refresh_hz": 90,
    "fov_restrict": {
      "override": [
        0.97,
        0.71,
        0.69,
        0.63
      ],
      "tol": 0.002,
      "render_saving": [
        -1.96,
        -1.93
      ],
      "verdict": "own_frustum",
      "truth": "symmetric max-tangent frustum + fixed 3840x2160 (our Gravity Rush 2 mod)"
    },
    "timestamps_monotonic": false
  }
}
