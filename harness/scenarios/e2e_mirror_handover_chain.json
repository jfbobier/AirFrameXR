{
  "description": "Field report (stillhappens2): the mirror holds the headset, a game's launcher stub starts and ends within a second (the mirror leaves), the streamer starts the mirror again a moment later, and the real game starts while that second mirror runs. Every mirror instance must see its signal and leave within 2 s, the engine must end each mirror's run before recording the next app, and the last app must keep the headset. Regression for a second game that never took the headset from the mirror.",
  "topology": {
    "host": "builder",
    "client": "builder",
    "client_bind_ip": "127.0.0.2",
    "host_launch": "interactive"
  },
  "session_overrides": {
    "session_settings.video.foveated_encoding.enabled": false,
    "openvr_config.enable_foveated_encoding": false,
    "openvr_config.eye_resolution_width": 1760,
    "openvr_config.eye_resolution_height": 1600,
    "openvr_config.target_eye_resolution_width": 1760,
    "openvr_config.target_eye_resolution_height": 1600,
    "session_settings.connection.client_recv_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.connection.server_send_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.video.transcoding_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    },
    "session_settings.video.emulated_headset_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    }
  },
  "host": {
    "shim": true,
    "fps": 90,
    "seconds": 90,
    "connect_timeout": 45,
    "gpu_keepalive": 90
  },
  "client": {
    "seconds": 85,
    "connect_timeout": 45,
    "yaw_amp": 0,
    "controllers": true
  },
  "client_env": {
    "RUST_LOG": "warn",
    "MOCK_HAND_YAW_DEG": "0",
    "MOCK_HAND_PITCH_DEG": "45"
  },
  "app": {
    "exe": "mirrordesktop",
    "seconds": 90,
    "timeout_s": 100,
    "synthetic": true,
    "then": [
      {
        "exe": "xr_probe",
        "after_s": 12,
        "frames": 3,
        "timeout_s": 30
      },
      {
        "exe": "mirrordesktop",
        "after_s": 4,
        "seconds": 60
      },
      {
        "exe": "xr_probe",
        "after_s": 9,
        "frames": 600,
        "timeout_s": 60
      }
    ]
  },
  "gpu_sample": true,
  "timeout_s": 330,
  "checks": {
    "max_duplicate_timestamps": 10000,
    "min_delivery_ratio": 0.3,
    "codec": "Hevc",
    "decode": false,
    "timestamps_monotonic": false,
    "handover_chain": {
      "max_leave_s": 2.0
    }
  }
}
