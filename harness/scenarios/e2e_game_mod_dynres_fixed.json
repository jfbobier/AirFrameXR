{
  "description": "What mods do wrong: a fixed frame copied into a bigger swapchain (EnshroudedVR's force_window, a resolution scale). The probe renders and submits a constant sub-rect (imageRect 75 % per axis of the swapchain) from its start, with the streamer's restriction on (0.97 / 0.71 / 0.69 / 0.63, Apple's frustum). The FOV is as told and the aspect is the told one but the size is not: `undecided` at the first start (the same numbers as a resolution scale).",
  "topology": {
    "host": "builder",
    "client": "builder",
    "client_bind_ip": "127.0.0.2",
    "host_launch": "interactive"
  },
  "session_overrides": {
    "session_settings.video.foveated_encoding.enabled": false,
    "openvr_config.enable_foveated_encoding": false,
    "openvr_config.eye_resolution_width": 1760,
    "openvr_config.eye_resolution_height": 1600,
    "openvr_config.target_eye_resolution_width": 1760,
    "openvr_config.target_eye_resolution_height": 1600,
    "session_settings.connection.client_recv_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.connection.server_send_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.video.transcoding_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    },
    "session_settings.video.emulated_headset_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    }
  },
  "host": {
    "shim": true,
    "fps": 90,
    "seconds": 60,
    "connect_timeout": 45,
    "gpu_keepalive": 90,
    "exit_after_frames": 1020,
    "fov_override": "0.97,0.71,0.69,0.63"
  },
  "client": {
    "seconds": 55,
    "connect_timeout": 45,
    "yaw_amp": 0.5,
    "yaw_hz": 0.25,
    "views_tan": "1.732,1.0,1.192,1.0"
  },
  "client_env": {
    "RUST_LOG": "warn"
  },
  "app": {
    "frames": 900,
    "timeout_s": 60,
    "env": {
      "XR_PROBE_DYNRES": "75"
    }
  },
  "gpu_sample": true,
  "timeout_s": 200,
  "checks": {
    "host_min_frames": 250,
    "client_min_frames": 200,
    "max_duplicate_timestamps": 400,
    "min_delivery_ratio": 0.7,
    "codec": "Hevc",
    "stream": {
      "codec_name": "hevc",
      "profile": "Main 10",
      "pix_fmt": "yuv420p10le",
      "width": 3520,
      "height": 1600,
      "color_range": "pc"
    },
    "decode": true,
    "decode_frame_slack": 40,
    "refresh_hz": 90,
    "timestamps_monotonic": false,
    "app_min_frames": 800,
    "third_party": {
      "exe": "xr_probe.exe",
      "verdict": "undecided",
      "follows": false
    }
  }
}
