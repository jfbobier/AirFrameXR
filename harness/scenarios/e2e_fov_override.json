{
  "description": "The streamer's field-of-view override (Advanced picture and FOV settings, shim fovScale): the game is told outer 1.20, inner 1.40, upper 1.00, lower 1.20 (tangents; the mock headset's own are 1.557 on every edge, so 77 / 90 / 64 / 77 % of it). The OpenXR app (xr_probe, which reads what UEVR reads) must get exactly those tangents (left eye: outer = left, right eye: outer = right), a recommended size reduced in proportion to the area, and the decoded stream must still cover the headset's whole view: the trimmed margins are black, the picture just inside them. The counter / gray patch / pose checks of e2e_openxr_probe do not apply. (timestamps_monotonic is left out: it flakes about half the time on this rig whatever the field of view, and the unrestricted control e2e_fov_restrict_none keeps it.)",
  "topology": {
    "host": "builder",
    "client": "builder",
    "client_bind_ip": "127.0.0.2",
    "host_launch": "interactive"
  },
  "session_overrides": {
    "session_settings.video.foveated_encoding.enabled": false,
    "openvr_config.enable_foveated_encoding": false,
    "openvr_config.eye_resolution_width": 1760,
    "openvr_config.eye_resolution_height": 1600,
    "openvr_config.target_eye_resolution_width": 1760,
    "openvr_config.target_eye_resolution_height": 1600,
    "session_settings.connection.client_recv_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.connection.server_send_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.video.transcoding_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    },
    "session_settings.video.emulated_headset_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    }
  },
  "host": {
    "shim": true,
    "fps": 90,
    "seconds": 60,
    "connect_timeout": 45,
    "gpu_keepalive": 90,
    "exit_after_frames": 420,
    "fov_override": "1.20,1.40,1.00,1.20"
  },
  "client": {
    "seconds": 55,
    "connect_timeout": 45,
    "yaw_amp": 0.5,
    "yaw_hz": 0.25
  },
  "client_env": {
    "RUST_LOG": "warn"
  },
  "app": {
    "frames": 420,
    "timeout_s": 60
  },
  "gpu_sample": true,
  "timeout_s": 200,
  "checks": {
    "host_min_frames": 250,
    "client_min_frames": 200,
    "max_duplicate_timestamps": 400,
    "min_delivery_ratio": 0.7,
    "codec": "Hevc",
    "stream": {
      "codec_name": "hevc",
      "profile": "Main 10",
      "pix_fmt": "yuv420p10le",
      "width": 3520,
      "height": 1600,
      "color_range": "pc"
    },
    "decode": true,
    "decode_frame_slack": 40,
    "app_min_frames": 300,
    "refresh_hz": 90,
    "fov_restrict": {
      "override": [
        1.2,
        1.4,
        1.0,
        1.2
      ],
      "tol": 0.002
    }
  }
}
