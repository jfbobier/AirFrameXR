{
  "description": "Frame generation at half rate with the stream fitted to the calibrated window (3168x2496 per eye, no foveation like e2e_fg_latency): the generator's flow size follows the frame, the run's latency is believable and the game_run record carries the pipeline block (game render, stream, encoded sizes, strips, encode times) that the Game statistics app draws.",
  "topology": {
    "host": "builder",
    "client": "builder",
    "client_bind_ip": "127.0.0.2",
    "host_launch": "interactive"
  },
  "session_overrides": {
    "session_settings.video.foveated_encoding.enabled": false,
    "openvr_config.enable_foveated_encoding": false,
    "openvr_config.eye_resolution_width": 3168,
    "openvr_config.eye_resolution_height": 2496,
    "openvr_config.target_eye_resolution_width": 3168,
    "openvr_config.target_eye_resolution_height": 2496,
    "session_settings.connection.client_recv_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.connection.server_send_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.video.transcoding_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 3168,
        "height": {
          "set": true,
          "content": 2496
        }
      },
      "variant": "Absolute"
    },
    "session_settings.video.emulated_headset_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 3168,
        "height": {
          "set": true,
          "content": 2496
        }
      },
      "variant": "Absolute"
    }
  },
  "host": {
    "shim": true,
    "fps": 90,
    "seconds": 70,
    "connect_timeout": 45,
    "gpu_keepalive": 90,
    "exit_after_frames": 100000,
    "running_start_ms": 2.0,
    "frame_gen": "on"
  },
  "client": {
    "seconds": 75,
    "connect_timeout": 45,
    "yaw_amp": 0.5,
    "yaw_hz": 0.25,
    "display_sim": true,
    "poll_ms": 5,
    "queue_max": 2,
    "motion": "yaw",
    "views_tan": "0.96,0.71,0.69,0.61"
  },
  "client_env": {
    "RUST_LOG": "warn"
  },
  "app": {
    "frames": 1800,
    "timeout_s": 60,
    "env": {
      "XR_PROBE_CPU_MS": "1",
      "XR_PROBE_GPU_COPIES": "0",
      "XR_PROBE_LOAD": "fps:50:70"
    }
  },
  "gpu_sample": true,
  "timeout_s": 220,
  "checks": {
    "host_min_frames": 600,
    "client_min_frames": 600,
    "game_run": {
      "max_latency_ms": 200,
      "max_latency_outliers": 0,
      "pipeline": {
        "stream_eye": [
          3168,
          2496
        ],
        "encoded": [
          6336,
          2496
        ],
        "foveated": false,
        "nvenc": {
          "split_mode": 3
        }
      }
    },
    "max_duplicate_timestamps": 10,
    "negotiated": {
      "view_resolution": [
        3168,
        2496
      ],
      "enable_foveated_encoding": false
    }
  }
}