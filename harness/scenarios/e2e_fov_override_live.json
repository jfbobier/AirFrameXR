{
 "description": "E4 (docs/PLAN_1_4_FOUNDATION.md): the field of view is one contract per streamer start (the box, the stream size, the foveation and the mask are compiled then), so the host no longer takes a restriction live: a `fov_override on 1.20 1.40 1.00 1.20` line on its stdin (what the 1.4 streamer sent when the user touched the FOV card) is ignored and said (event command_ignored), and the game that starts afterwards gets the headset's own field of view. Host started with --gui (reads the stdin commands). (timestamps_monotonic is left out: it flakes about half the time on this rig whatever the field of view.)",
 "topology": {
  "host": "builder",
  "client": "builder",
  "client_bind_ip": "127.0.0.2",
  "host_launch": "interactive"
 },
 "session_overrides": {
  "session_settings.video.foveated_encoding.enabled": false,
  "openvr_config.enable_foveated_encoding": false,
  "openvr_config.eye_resolution_width": 1760,
  "openvr_config.eye_resolution_height": 1600,
  "openvr_config.target_eye_resolution_width": 1760,
  "openvr_config.target_eye_resolution_height": 1600,
  "session_settings.connection.client_recv_buffer_bytes": {
   "variant": "Custom",
   "Custom": 16777216
  },
  "session_settings.connection.server_send_buffer_bytes": {
   "variant": "Custom",
   "Custom": 16777216
  },
  "session_settings.video.transcoding_view_resolution": {
   "Scale": 1.0,
   "Absolute": {
    "width": 1760,
    "height": {
     "set": true,
     "content": 1600
    }
   },
   "variant": "Absolute"
  },
  "session_settings.video.emulated_headset_view_resolution": {
   "Scale": 1.0,
   "Absolute": {
    "width": 1760,
    "height": {
     "set": true,
     "content": 1600
    }
   },
   "variant": "Absolute"
  }
 },
 "host": {
  "shim": true,
  "fps": 90,
  "seconds": 60,
  "connect_timeout": 45,
  "gpu_keepalive": 90,
  "exit_after_frames": 420,
  "gui": true
 },
 "client": {
  "seconds": 55,
  "connect_timeout": 45,
  "yaw_amp": 0.5,
  "yaw_hz": 0.25
 },
 "client_env": {
  "RUST_LOG": "warn"
 },
 "app": {
  "frames": 420,
  "timeout_s": 60
 },
 "gpu_sample": true,
 "timeout_s": 200,
 "checks": {
  "host_min_frames": 250,
  "client_min_frames": 200,
  "max_duplicate_timestamps": 400,
  "min_delivery_ratio": 0.7,
  "codec": "Hevc",
  "stream": {
   "codec_name": "hevc",
   "profile": "Main 10",
   "pix_fmt": "yuv420p10le",
   "width": 3520,
   "height": 1600,
   "color_range": "pc"
  },
  "decode": true,
  "decode_frame_slack": 40,
  "app_min_frames": 300,
  "refresh_hz": 90,
  "fov_restrict": {
   "scale": [
    100,
    100,
    100,
    100
   ],
   "tol": 0.002
  },
  "timestamps_monotonic": false,
  "host_events": {
   "command_ignored": 1
  }
 },
 "stdin_feed": {
  "events": [
   {
    "t": 2,
    "line": "fov_override on 1.20 1.40 1.00 1.20"
   }
  ],
  "hold_s": 150
 }
}