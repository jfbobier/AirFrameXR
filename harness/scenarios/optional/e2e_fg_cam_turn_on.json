{
 "description": "CAMERA TURN, the streamer path: e2e_fg_latency (generation on, the probe app, the mock headset) with the lab switch AIRFRAMEXR_FG_CAM_TURN=1 (nvenc/hostlib/framegen.h camTurn: the stick-turn compensation). The same checks as e2e_fg_latency must pass (the switch must not break the generation path); the host log must carry the 'frame generation camera turn:' lines and 'camera turn' in 'frame generation ON' (read by hand). The quality numbers come from harness/fg_judge.py --pans ... --pan-warm 3 --env AIRFRAMEXR_FG_CAM_TURN=1 (docs/FRAME_GENERATION_JUDGE.md).",
 "topology": {
  "host": "builder",
  "client": "builder",
  "client_bind_ip": "127.0.0.2",
  "host_launch": "interactive"
 },
 "session_overrides": {
  "session_settings.video.foveated_encoding.enabled": false,
  "openvr_config.enable_foveated_encoding": false,
  "openvr_config.eye_resolution_width": 1760,
  "openvr_config.eye_resolution_height": 1600,
  "openvr_config.target_eye_resolution_width": 1760,
  "openvr_config.target_eye_resolution_height": 1600,
  "session_settings.connection.client_recv_buffer_bytes": {
   "variant": "Custom",
   "Custom": 16777216
  },
  "session_settings.connection.server_send_buffer_bytes": {
   "variant": "Custom",
   "Custom": 16777216
  },
  "session_settings.video.transcoding_view_resolution": {
   "Scale": 1.0,
   "Absolute": {
    "width": 1760,
    "height": {
     "set": true,
     "content": 1600
    }
   },
   "variant": "Absolute"
  },
  "session_settings.video.emulated_headset_view_resolution": {
   "Scale": 1.0,
   "Absolute": {
    "width": 1760,
    "height": {
     "set": true,
     "content": 1600
    }
   },
   "variant": "Absolute"
  }
 },
 "host": {
  "shim": true,
  "fps": 90,
  "seconds": 70,
  "connect_timeout": 45,
  "gpu_keepalive": 90,
  "exit_after_frames": 100000,
  "running_start_ms": 2.0,
  "frame_gen": "on",
  "env": {
   "AIRFRAMEXR_FG_CAM_TURN": "1"
  }
 },
 "client": {
  "seconds": 75,
  "connect_timeout": 45,
  "yaw_amp": 0.5,
  "yaw_hz": 0.25,
  "display_sim": true,
  "poll_ms": 5,
  "queue_max": 2,
  "motion": "yaw"
 },
 "client_env": {
  "RUST_LOG": "warn"
 },
 "app": {
  "frames": 1800,
  "timeout_s": 60,
  "env": {
   "XR_PROBE_CPU_MS": "1",
   "XR_PROBE_GPU_COPIES": "0",
   "XR_PROBE_LOAD": "fps:50:70"
  }
 },
 "gpu_sample": true,
 "timeout_s": 220,
 "checks": {
  "host_min_frames": 600,
  "client_min_frames": 600,
  "game_run": {
   "max_latency_ms": 200,
   "max_latency_outliers": 0
  },
  "max_duplicate_timestamps": 10,
  "fg": {
   "frame": [
    3520,
    1600
   ],
   "synth_share": [
    0.4,
    0.6
   ],
   "min_stream_fps_frac": 0.95,
   "synth_ms_per_mpx": [
    0.02,
    0.1
   ]
  }
 }
}