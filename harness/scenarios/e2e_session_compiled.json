{
  "description": "SESSION COMPILED LIKE THE STREAMER: e2e_baseline, but the session the host runs is what SessionCompiler (the launcher's own start-up compile, run on the builder) makes from the fixture as the golden master for a Vision Pro (bitrate-sized stream, foveation from the picture edges and Apple's map, pairing). Same checks as the baseline: the compiled session must stream, decode and pace like it. 3 runs of this must not differ from e2e_baseline beyond noise before the compile is trusted for more scenarios.",
  "topology": {
    "host": "builder",
    "client": "builder",
    "client_bind_ip": "127.0.0.2",
    "host_launch": "interactive"
  },
  "session_overrides": {},
  "host": {
    "shim": true,
    "fps": 90,
    "seconds": 60,
    "connect_timeout": 45,
    "gpu_keepalive": 90,
    "exit_after_frames": 900
  },
  "client": {
    "seconds": 55,
    "connect_timeout": 45,
    "yaw_amp": 0.5,
    "yaw_hz": 0.25
  },
  "client_env": {
    "RUST_LOG": "warn"
  },
  "app": {
    "frames": 900,
    "timeout_s": 60
  },
  "gpu_sample": true,
  "timeout_s": 200,
  "checks": {
    "host_min_frames": 250,
    "client_min_frames": 200,
    "timestamps_monotonic": true,
    "max_duplicate_timestamps": 400,
    "min_delivery_ratio": 0.7,
    "codec": "Hevc",
    "stream": {
      "codec_name": "hevc",
      "profile": "Main 10",
      "pix_fmt": "yuv420p10le",
      "color_range": "pc"
    },
    "decode": true,
    "decode_frame_slack": 60,
    "counter_readback": true,
    "counter_block_px": 64,
    "gray_patch": [
      176,
      200
    ],
    "app_min_frames": 300,
    "pose_roundtrip_max_rad": 0.06,
    "min_yaw_range_rad": 0.3,
    "refresh_hz": 90,
    "max_pipeline_latency_ms": 150,
    "negotiated": {
      "view_resolution": [
        3552,
        3200
      ],
      "use_full_range": true,
      "enable_foveated_encoding": true
    },
    "foveation": true,
    "max_encode_ms_p95": 16,
    "pacing": {
      "warmup_frames": 30,
      "client_p99_ms": 20,
      "max_late_frac": 0.01,
      "vsync_p99_ms": 12.5,
      "vsync_max_ms": 40,
      "intake_p99_ms": 16,
      "max_gap_periods": 2.6,
      "p50_tolerance": 0.03,
      "max_late_run": 2,
      "max_drift_ms": 4.0
    }
  },
  "compile": {
    "settings": {
      "headset": {
        "name": "Apple Headset"
      },
      "video": {}
    },
    "views": [
      0.97,
      0.71,
      0.69,
      0.63
    ]
  }
}
