{
  "description": "Frame generation OFF, a free-running game at 95-99 fps (CPU-bound xr_probe), 100 Hz host. Client: Vision Pro display emulation at 100 Hz with the latency model (network 2.5 / decode 7 / draw 2 ms, each mean + Gaussian). Eye size 1280x1120: the 3080 Ti laptop's single NVENC engine cannot encode 3520x1600 at 100 fps (encode ~10 ms), which capped both runs near 88-93 fps.",
  "topology": {
    "host": "builder",
    "client": "builder",
    "client_bind_ip": "127.0.0.2",
    "host_launch": "interactive"
  },
  "session_overrides": {
    "session_settings.video.foveated_encoding.enabled": false,
    "openvr_config.enable_foveated_encoding": false,
    "openvr_config.eye_resolution_width": 1280,
    "openvr_config.eye_resolution_height": 1120,
    "openvr_config.target_eye_resolution_width": 1280,
    "openvr_config.target_eye_resolution_height": 1120,
    "session_settings.connection.client_recv_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.connection.server_send_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.video.transcoding_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1280,
        "height": {
          "set": true,
          "content": 1120
        }
      },
      "variant": "Absolute"
    },
    "session_settings.video.emulated_headset_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1280,
        "height": {
          "set": true,
          "content": 1120
        }
      },
      "variant": "Absolute"
    }
  },
  "host": {
    "shim": true,
    "fps": 100,
    "seconds": 70,
    "connect_timeout": 45,
    "gpu_keepalive": 90,
    "exit_after_frames": 100000
  },
  "client": {
    "seconds": 65,
    "connect_timeout": 45,
    "yaw_amp": 0.5,
    "yaw_hz": 0.25,
    "display_sim": true,
    "display_hz": 100,
    "poll_ms": 5.0,
    "queue_max": 2,
    "motion": "yaw",
    "net_ms": 2.5,
    "net_sd_ms": 1.0,
    "decode_ms": 7,
    "decode_sd_ms": 1.0,
    "draw_ms": 2.0,
    "draw_sd_ms": 0.7
  },
  "client_env": {
    "RUST_LOG": "warn"
  },
  "app": {
    "frames": 6000,
    "timeout_s": 75,
    "env": {
      "XR_PROBE_CPU_MS": "1",
      "XR_PROBE_GPU_COPIES": "0",
      "XR_PROBE_LOAD": "fps:95:99"
    }
  },
  "gpu_sample": true,
  "timeout_s": 200,
  "checks": {
    "host_min_frames": 250,
    "client_min_frames": 200,
    "max_duplicate_timestamps": 100000
  }
}