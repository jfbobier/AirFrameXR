{
  "description": "THE WHOLE CHAIN OF A USER'S CHOICE, without a lab flag or a stdin line: the launcher's FOV card writes the settings file (here with the GUI's own code, UserFovStore.Apply, run through uitest.exe: video.fov_override on, the four tangents 1.20 / 1.40 / 1.00 / 1.20 clamped to the mock headset's 1.557, the profile id, fov_for) into the portable folder's config\\airframexr.json; the host started from that folder reads it at its start and publishes it (event fov_restrict, why override); the shim answers the OpenXR app (xr_probe, which reads what UEVR reads) with exactly those tangents and a recommended size reduced in proportion to the area; the decoded stream still covers the headset's whole view (trimmed margins black, picture just inside). Same checks as e2e_fov_override, which uses the lab flag. Needs the portable folder (python3 harness/run.py build gui package) and uitest.exe (python3 harness/ui_matrix.py). (timestamps_monotonic is left out: it flakes about half the time on this rig whatever the field of view.)",
  "topology": {
    "host": "builder",
    "client": "builder",
    "client_bind_ip": "127.0.0.2",
    "host_launch": "interactive"
  },
  "session_overrides": {
    "session_settings.video.foveated_encoding.enabled": false,
    "openvr_config.enable_foveated_encoding": false,
    "openvr_config.eye_resolution_width": 1760,
    "openvr_config.eye_resolution_height": 1600,
    "openvr_config.target_eye_resolution_width": 1760,
    "openvr_config.target_eye_resolution_height": 1600,
    "session_settings.connection.client_recv_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.connection.server_send_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.video.transcoding_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    },
    "session_settings.video.emulated_headset_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    }
  },
  "host": {
    "shim": true,
    "fps": 90,
    "seconds": 60,
    "connect_timeout": 45,
    "gpu_keepalive": 90,
    "exit_after_frames": 420
  },
  "client": {
    "seconds": 55,
    "connect_timeout": 45,
    "yaw_amp": 0.5,
    "yaw_hz": 0.25
  },
  "client_env": {
    "RUST_LOG": "warn"
  },
  "app": {
    "frames": 420,
    "timeout_s": 60
  },
  "gpu_sample": true,
  "timeout_s": 200,
  "checks": {
    "host_min_frames": 250,
    "client_min_frames": 200,
    "max_duplicate_timestamps": 400,
    "min_delivery_ratio": 0.7,
    "codec": "Hevc",
    "stream": {
      "codec_name": "hevc",
      "profile": "Main 10",
      "pix_fmt": "yuv420p10le",
      "width": 3520,
      "height": 1600,
      "color_range": "pc"
    },
    "decode": true,
    "decode_frame_slack": 40,
    "app_min_frames": 300,
    "refresh_hz": 90,
    "fov_restrict": {
      "override": [
        1.2,
        1.4,
        1.0,
        1.2
      ],
      "tol": 0.002
    },
    "timestamps_monotonic": false,
    "fov_restrict_event": true
  },
  "install": true,
  "fov_settings_from_gui": {
    "tan": [
      1.2,
      1.4,
      1.0,
      1.2
    ],
    "client": [
      1.557,
      1.557,
      1.557,
      1.557
    ]
  }
}