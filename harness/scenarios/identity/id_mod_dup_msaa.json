{
  "description": "FRAME-IDENTITY MATRIX (docs/PLAN_UNIVERSAL_OPENXR.md, run with `run.py identity` for each arm; not part of `all`: some rows fail on 1.3.11 by design, that failure is the baseline). xr_modsim writes what each submit really was (images released, new picture or not, same poses or not); the checks compare it with VDXR's per-frame facts and with what the shim did (since 2026-11-24 the compatibility mode drops nothing on any arm; it frees the wait before a confirmed repeat). Row: the mod's loop with 4x MSAA swapchains: both eyes go through VDXR's resolve copy. Want: as id_mod_dup, VDXR resolves on real frames only.",
  "topology": {
    "host": "builder",
    "client": "builder",
    "client_bind_ip": "127.0.0.2",
    "host_launch": "interactive"
  },
  "session_overrides": {
    "session_settings.video.foveated_encoding.enabled": false,
    "openvr_config.enable_foveated_encoding": false,
    "openvr_config.eye_resolution_width": 1760,
    "openvr_config.eye_resolution_height": 1600,
    "openvr_config.target_eye_resolution_width": 1760,
    "openvr_config.target_eye_resolution_height": 1600,
    "session_settings.connection.client_recv_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.connection.server_send_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.video.transcoding_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    },
    "session_settings.video.emulated_headset_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    }
  },
  "host": {
    "shim": true,
    "fps": 90,
    "seconds": 75,
    "connect_timeout": 45,
    "gpu_keepalive": 90,
    "exit_after_frames": 100000,
    "running_start_ms": 2.0,
    "frame_gen": "on",
    "frame_gen_rate": "half",
    "drop_duplicate_frames": true
  },
  "client": {
    "seconds": 80,
    "connect_timeout": 45,
    "yaw_amp": 0.5,
    "yaw_hz": 0.25,
    "display_sim": true,
    "poll_ms": 5,
    "queue_max": 2,
    "motion": "yaw"
  },
  "client_env": {
    "RUST_LOG": "warn"
  },
  "app": {
    "exe": "xr_modsim",
    "frames": 1500,
    "timeout_s": 70,
    "env": {
      "MODSIM_ENGINE_MS": "9",
      "MODSIM_GPU_COPIES": "0",
      "MODSIM_DUP": "1",
      "MODSIM_POOL": "9",
      "MODSIM_SWITCH_S": "25",
      "MODSIM_MSAA": "4"
    }
  },
  "gpu_sample": true,
  "timeout_s": 240,
  "checks": {
    "host_min_frames": 600,
    "client_min_frames": 600,
    "max_duplicate_timestamps": 100000,
    "vdxr_trace": {
      "min_frames": 900,
      "slices_per_frame": [
        1.95,
        2.05
      ],
      "copied_per_frame": [
        0.9,
        1.05
      ],
      "unchanged_per_frame": [
        0.9,
        1.05
      ]
    },
    "identity": {
      "min_submits": 900,
      "shape": {
        "true_dup": [
          0.45,
          0.55
        ]
      },
      "min_true_dups_freed_frac": 0.9,
      "max_dropped_new_pictures_frac": 0.02
    }
  }
}
