{
  "description": "U5b (docs/permanent_record/PLAN_0.5.md): the mock headset at 1.62 m, the host told height 1.55 (Manual: the typed value); height_calibrated must report the eye height 1.55 m.",
  "topology": {
    "host": "builder",
    "client": "builder",
    "client_bind_ip": "127.0.0.2",
    "host_launch": "interactive"
  },
  "session_overrides": {
    "session_settings.video.foveated_encoding.enabled": false,
    "openvr_config.enable_foveated_encoding": false,
    "openvr_config.eye_resolution_width": 1760,
    "openvr_config.eye_resolution_height": 1600,
    "openvr_config.target_eye_resolution_width": 1760,
    "openvr_config.target_eye_resolution_height": 1600,
    "session_settings.connection.client_recv_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.connection.server_send_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.video.transcoding_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    },
    "session_settings.video.emulated_headset_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    }
  },
  "host": {
    "shim": true,
    "fps": 90,
    "seconds": 15,
    "connect_timeout": 45,
    "gpu_keepalive": 90,
    "height_m": 1.55
  },
  "client": {
    "seconds": 10,
    "connect_timeout": 45,
    "height": 1.62
  },
  "client_env": {
    "RUST_LOG": "warn"
  },
  "timeout_s": 120,
  "checks": {
    "client_min_frames": 100,
    "height_calibrated": {
      "eye_height_m": 1.55,
      "headset_y": 1.62,
      "tol": 0.03
    },
    "max_duplicate_timestamps": 400
  }
}