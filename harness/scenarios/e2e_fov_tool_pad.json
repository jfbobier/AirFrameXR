{
  "description": "Xbox controller in the fit tool (tools/probe/xr_tool.h, for laptops without a numpad): the line style starts at 0.8 of the panel and on the corner fractions 0.8 / 0.8 / 0.7 / 0.8 (left eye), 0.9 / 0.8 / 0.7 / 0.8 (right); scripted pad events, through the same mapping as a real controller: A starts, the right stick up pushes the left eye's upper edge out two steps, the left stick left brings its outer edge back one, the right stick up-left pushes its upper-outer corner line out three, the left stick down-right brings its lower-inner back one; A (the other eye), the right stick right pushes the right eye's outer edge out one, down-left its lower-inner corner out one; A saves. The edges (0.5 degree a step) and the corners (0.01) must end where the sticks put them.",
  "topology": {
    "host": "builder",
    "client": "builder",
    "client_bind_ip": "127.0.0.2",
    "host_launch": "interactive"
  },
  "session_overrides": {
    "session_settings.video.foveated_encoding.enabled": false,
    "openvr_config.enable_foveated_encoding": false,
    "openvr_config.eye_resolution_width": 1760,
    "openvr_config.eye_resolution_height": 1600,
    "openvr_config.target_eye_resolution_width": 1760,
    "openvr_config.target_eye_resolution_height": 1600,
    "session_settings.connection.client_recv_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.connection.server_send_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.video.transcoding_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    },
    "session_settings.video.emulated_headset_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    }
  },
  "host": {
    "shim": true,
    "fps": 90,
    "seconds": 60,
    "connect_timeout": 45,
    "gpu_keepalive": 90,
    "exit_after_frames": 1250,
    "gui": true
  },
  "client": {
    "seconds": 55,
    "connect_timeout": 45,
    "yaw_amp": 0.5,
    "yaw_hz": 0.25,
    "views_tan": "1.732,1.0,1.192,1.0"
  },
  "client_env": {
    "RUST_LOG": "warn"
  },
  "app": {
    "frames": 1400,
    "timeout_s": 60,
    "env": {
      "XR_PROBE_TOOL": "fit",
      "XR_PROBE_TOOL_START": "0.8",
      "XR_PROBE_KEYS": "120:a,150:rs_up,154:rs_up,170:ls_left,190:rs_upleft,194:rs_upleft,198:rs_upleft,210:ls_downright,330:a,350:rs_right,360:rs_downleft,1000:a",
      "XR_PROBE_START_CORNERS": "0.8,0.8,0.7,0.8,0.9,0.8,0.7,0.8"
    }
  },
  "gpu_sample": true,
  "timeout_s": 240,
  "checks": {
    "host_min_frames": 800,
    "client_min_frames": 700,
    "timestamps_monotonic": true,
    "max_duplicate_timestamps": 400,
    "min_delivery_ratio": 0.7,
    "codec": "Hevc",
    "stream": {
      "codec_name": "hevc",
      "profile": "Main 10",
      "pix_fmt": "yuv420p10le",
      "width": 3520,
      "height": 1600,
      "color_range": "pc"
    },
    "decode": true,
    "refresh_hz": 90,
    "max_pipeline_latency_ms": 150,
    "decode_frame_slack": 60,
    "tool": {
      "corners": [
        [
          0.83,
          0.8,
          0.69,
          0.8
        ],
        [
          0.9,
          0.8,
          0.71,
          0.8
        ]
      ],
      "corners_tol": 0.006,
      "expect": {
        "start": 0.8,
        "deltas": [
          [
            -0.5,
            0.0,
            1.0,
            0.0
          ],
          [
            0.5,
            0.0,
            0.0,
            0.0
          ]
        ]
      }
    }
  }
}