{
 "description": "1:1 COMPARISON with stock, an app with random frame times between 45 and 75 fps (never in step with the display); 1024x1024 per eye @ 60 Hz, Littlest Tokyo, the real 60 Hz-resampled head trace (prediction 100)",
 "topology": {
  "host": "builder",
  "client": "builder",
  "client_bind_ip": "127.0.0.2",
  "host_launch": "interactive"
 },
 "session_overrides": {
  "session_settings.video.foveated_encoding.enabled": false,
  "openvr_config.enable_foveated_encoding": false,
  "openvr_config.eye_resolution_width": 1024,
  "openvr_config.eye_resolution_height": 1024,
  "openvr_config.target_eye_resolution_width": 1024,
  "openvr_config.target_eye_resolution_height": 1024,
  "session_settings.connection.client_recv_buffer_bytes": {
   "variant": "Custom",
   "Custom": 16777216
  },
  "session_settings.connection.server_send_buffer_bytes": {
   "variant": "Custom",
   "Custom": 16777216
  },
  "session_settings.video.transcoding_view_resolution": {
   "Scale": 1.0,
   "Absolute": {
    "width": 1024,
    "height": {
     "set": true,
     "content": 1024
    }
   },
   "variant": "Absolute"
  },
  "session_settings.video.emulated_headset_view_resolution": {
   "Scale": 1.0,
   "Absolute": {
    "width": 1024,
    "height": {
     "set": true,
     "content": 1024
    }
   },
   "variant": "Absolute"
  },
  "openvr_config.refresh_rate": 60,
  "session_settings.video.preferred_fps": 60.0
 },
 "host": {
  "shim": true,
  "fps": 60,
  "seconds": 40,
  "connect_timeout": 45,
  "exit_after_frames": 2400,
  "send_pacing": "phase",
  "running_start_ms": 2.0,
  "gpu_sched_class": 5
 },
 "client": {
  "seconds": 44,
  "connect_timeout": 45,
  "display_sim": true,
  "poll_ms": 5,
  "queue_max": 2,
  "refresh": 60,
  "display_hz": 60,
  "replay": "harness/fixtures/headtraces/real_probe_pred100_60hz.csv",
  "real_views": true,
  "no_stream_dump": true
 },
 "client_env": {
  "RUST_LOG": "warn"
 },
 "app": {
  "frames": 2600,
  "timeout_s": 51,
  "env": {
   "XR_PROBE_CPU_MS": "1",
   "XR_PROBE_GPU_COPIES": "0",
   "XR_PROBE_LOAD": "fps:45:75",
   "XR_PROBE_SCENE": "bench\\\\littlest_tokyo.vab"
  }
 },
 "gpu_sample": true,
 "timeout_s": 200,
 "checks": {
  "host_min_frames": 600,
  "client_min_frames": 600
 }
}