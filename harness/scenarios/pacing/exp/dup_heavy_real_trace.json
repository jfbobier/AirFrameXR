{
  "description": "DUPLICATE TIMESTAMPS: a GPU-bound, bunching app (CPU 3 ms, 30 big GPU copies, frame-time jitter 45 %) under the recorded REAL head trace of a Cyberpunk session (real samples, timestamps and uplink timing): the lab's closest match to the real headset's 12-16 frames per second that carry the previous frame's timestamp. Compare head-sample policies (OVRSHIM_INORDER_POSE, OVRSHIM_TRACK_WAIT_MS, OVRSHIM_ALIGN_RELEASE) on dup/skip, repeats and pose age; harness/frames.py joins the frames.",
  "topology": {
    "host": "builder",
    "client": "builder",
    "client_bind_ip": "127.0.0.2",
    "host_launch": "interactive"
  },
  "session_overrides": {
    "session_settings.video.foveated_encoding.enabled": false,
    "openvr_config.enable_foveated_encoding": false,
    "openvr_config.eye_resolution_width": 1760,
    "openvr_config.eye_resolution_height": 1600,
    "openvr_config.target_eye_resolution_width": 1760,
    "openvr_config.target_eye_resolution_height": 1600,
    "session_settings.connection.client_recv_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.connection.server_send_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.video.transcoding_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    },
    "session_settings.video.emulated_headset_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    }
  },
  "host": {
    "shim": true,
    "fps": 90,
    "seconds": 40,
    "connect_timeout": 45,
    "gpu_keepalive": 90,
    "exit_after_frames": 3400,
    "send_pacing": "phase",
    "running_start_ms": 2.0,
    "gpu_sched_class": 5
  },
  "client": {
    "seconds": 44,
    "connect_timeout": 45,
    "display_sim": true,
    "poll_ms": 5,
    "queue_max": 2,
    "refresh": 100,
    "display_hz": 100,
    "replay": "harness/fixtures/headtraces/real_cyberpunk_pred0.csv",
    "real_views": true
  },
  "client_env": {
    "RUST_LOG": "warn"
  },
  "app": {
    "frames": 3600,
    "timeout_s": 55,
    "env": {
      "XR_PROBE_CPU_MS": "3",
      "XR_PROBE_GPU_COPIES": "30",
      "XR_PROBE_LOAD": "jitter:45",
      "XR_PROBE_SCENE": "bench\\\\littlest_tokyo.vab"
    }
  },
  "gpu_sample": true,
  "timeout_s": 200,
  "checks": {
    "host_min_frames": 600,
    "client_min_frames": 600
  }
}