{
 "description": "STILL HEAD with large pose noise (500 mdeg uniform per sample: what the client's velocity prediction does to a still head): is every frame's content pose exactly the pose stamped (marker check)? ",
 "topology": {
  "host": "builder",
  "client": "builder",
  "client_bind_ip": "127.0.0.2",
  "host_launch": "interactive"
 },
 "session_overrides": {
  "session_settings.video.foveated_encoding.enabled": false,
  "openvr_config.enable_foveated_encoding": false,
  "openvr_config.eye_resolution_width": 1760,
  "openvr_config.eye_resolution_height": 1600,
  "openvr_config.target_eye_resolution_width": 1760,
  "openvr_config.target_eye_resolution_height": 1600,
  "session_settings.connection.client_recv_buffer_bytes": {
   "variant": "Custom",
   "Custom": 16777216
  },
  "session_settings.connection.server_send_buffer_bytes": {
   "variant": "Custom",
   "Custom": 16777216
  },
  "session_settings.video.transcoding_view_resolution": {
   "Scale": 1.0,
   "Absolute": {
    "width": 1760,
    "height": {
     "set": true,
     "content": 1600
    }
   },
   "variant": "Absolute"
  },
  "session_settings.video.emulated_headset_view_resolution": {
   "Scale": 1.0,
   "Absolute": {
    "width": 1760,
    "height": {
     "set": true,
     "content": 1600
    }
   },
   "variant": "Absolute"
  }
 },
 "host": {
  "shim": true,
  "fps": 90,
  "seconds": 50,
  "connect_timeout": 45,
  "gpu_keepalive": 90,
  "exit_after_frames": 2000,
  "send_pacing": "phase",
  "running_start_ms": 2.0,
  "gpu_sched_class": 5
 },
 "client": {
  "seconds": 55,
  "connect_timeout": 45,
  "yaw_amp": 0.8,
  "yaw_hz": 0.5,
  "display_sim": true,
  "poll_ms": 5,
  "queue_max": 2,
  "motion": "still",
  "ts_jitter_ns": 40,
  "noise_mdeg": 500
 },
 "client_env": {
  "RUST_LOG": "warn"
 },
 "app": {
  "frames": 1800,
  "timeout_s": 60,
  "env": {
   "XR_PROBE_CPU_MS": "1",
   "XR_PROBE_GPU_COPIES": "0",
   "XR_PROBE_LOAD": "fps:85:100",
   "XR_PROBE_SCENE": "bench\\\\littlest_tokyo.vab"
  }
 },
 "gpu_sample": true,
 "timeout_s": 200,
 "checks": {
  "host_min_frames": 600,
  "client_min_frames": 600
 }
}