    "openvr_config.eye_resolution_width": 1248,
    "openvr_config.eye_resolution_height": 1120,
    "openvr_config.target_eye_resolution_width": 1248,
    "openvr_config.target_eye_resolution_height": 1120,
    "session_settings.connection.client_recv_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.connection.server_send_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.video.transcoding_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1248,
        "height": {
          "set": true,
          "content": 1120
        }
      },
      "variant": "Absolute"
    },
    "session_settings.video.emulated_headset_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1248,
        "height": {
          "set": true,
          "content": 1120
        }
      },
      "variant": "Absolute"
    }
  },
  "host": {
    "shim": true,
    "fps": 90,
    "seconds": 70,
    "connect_timeout": 45,
    "gpu_keepalive": 90,
    "exit_after_frames": 100000,
    "running_start_ms": 2.0,
    "frame_gen": "on",
    "env": {
      "AIRFRAMEXR_FG_SYNTH": "neural"
    },
    "frame_gen_rate": "third"
  },
  "client": {
    "seconds": 75,
    "connect_timeout": 45,
    "yaw_amp": 0.5,
    "yaw_hz": 0.25,
    "display_sim": true,
    "poll_ms": 5,
    "queue_max": 2,
    "motion": "yaw"
  },
  "client_env": {
    "RUST_LOG": "warn"
  },
  "app": {
    "frames": 1200,
    "timeout_s": 60,
    "env": {
      "XR_PROBE_CPU_MS": "1",
      "XR_PROBE_GPU_COPIES": "0",
      "XR_PROBE_LOAD": "fps:50:70"
    }
  },
  "gpu_sample": true,
  "timeout_s": 220,
  "checks": {
