    },
    "max_duplicate_timestamps": 10,
    "fg": {
      "frame": [
        2496,
        1120
      ],
      "synth_share": [
        0.55,
        0.75
      ],
      "min_stream_fps_frac": 0.95,
      "synth_ms_per_mpx": [
        0.005,
        0.1
      ],
      "neural": true
    }
  }
