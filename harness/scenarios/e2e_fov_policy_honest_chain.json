{
  "description": "The base case of the restriction policy (owner, 2026-11-06): an honest game (UEVR, a native OpenXR game), nobody trusted. Start 1 is told the whole view whatever the streamer's restriction (the fit 0.97 / 0.71 / 0.69 / 0.63) and follows it: `honours`, predicted (not proven). Start 2 is told the restriction and follows it: `honours`, proven. It never loses picture, and from the second start it renders fewer pixels.",
  "topology": {
    "host": "builder",
    "client": "builder",
    "client_bind_ip": "127.0.0.2",
    "host_launch": "interactive"
  },
  "session_overrides": {
    "session_settings.video.foveated_encoding.enabled": false,
    "openvr_config.enable_foveated_encoding": false,
    "openvr_config.eye_resolution_width": 1760,
    "openvr_config.eye_resolution_height": 1600,
    "openvr_config.target_eye_resolution_width": 1760,
    "openvr_config.target_eye_resolution_height": 1600,
    "session_settings.connection.client_recv_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.connection.server_send_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.video.transcoding_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    },
    "session_settings.video.emulated_headset_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    }
  },
  "host": {
    "shim": true,
    "fps": 90,
    "seconds": 60,
    "connect_timeout": 45,
    "gpu_keepalive": 90,
    "exit_after_frames": 420,
    "fov_override": "0.97,0.71,0.69,0.63",
    "fov_whitelist": []
  },
  "client": {
    "seconds": 55,
    "connect_timeout": 45,
    "yaw_amp": 0.5,
    "yaw_hz": 0.25,
    "views_tan": "1.732,1.0,1.192,1.0"
  },
  "client_env": {
    "RUST_LOG": "warn"
  },
  "app": {
    "frames": 600,
    "timeout_s": 60,
    "env": {},
    "then": [
      {
        "exe": "xr_probe",
        "after_s": 25,
        "frames": 600,
        "timeout_s": 60,
        "env": {}
      }
    ]
  },
  "gpu_sample": true,
  "timeout_s": 200,
  "checks": {
    "host_min_frames": 250,
    "client_min_frames": 200,
    "max_duplicate_timestamps": 400,
    "min_delivery_ratio": 0.7,
    "codec": "Hevc",
    "stream": {
      "codec_name": "hevc",
      "profile": "Main 10",
      "pix_fmt": "yuv420p10le",
      "width": 3520,
      "height": 1600,
      "color_range": "pc"
    },
    "decode": true,
    "decode_frame_slack": 40,
    "app_min_frames": 300,
    "refresh_hz": 90,
    "fov_restrict": {
      "scale": [
        100,
        100,
        100,
        100
      ],
      "tol": 0.002,
      "truth": "honours FOV and size",
      "starts": [
        {
          "verdict": "honours",
          "unrestricted": true,
          "proven": false
        },
        {
          "verdict": "honours",
          "unrestricted": false,
          "proven": true
        }
      ]
    }
  }
}
