{
  "description": "NEURAL FRAME GENERATION AT A SMALLER STREAM (owner, 2026-11-24: what a mid-range GPU really plays, e.g. a Quest's stream on an RTX 3080 Ti Laptop): e2e_fg_neural with a 1248x1120 eye (50 % of the lab's 1760x1600 pixels), x2 at 90 Hz, network scale 0.5. On the 3080 Ti Laptop 2026-11-24: neural 5.2 ms a run, stream 89.1 / 88.5 fps (at 1760x1600: 7.7 ms, 65 fps). Must hold 95 % of the display rate on every rig; the laptop's neural run time is bounded in harness/rigs.json.",
  "topology": {
    "host": "builder",
    "client": "builder",
    "client_bind_ip": "127.0.0.2",
    "host_launch": "interactive"
  },
  "session_overrides": {
    "session_settings.video.foveated_encoding.enabled": false,
    "openvr_config.enable_foveated_encoding": false,
    "openvr_config.eye_resolution_width": 1248,
    "openvr_config.eye_resolution_height": 1120,
    "openvr_config.target_eye_resolution_width": 1248,
    "openvr_config.target_eye_resolution_height": 1120,
    "session_settings.connection.client_recv_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.connection.server_send_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.video.transcoding_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1248,
        "height": {
          "set": true,
          "content": 1120
        }
      },
      "variant": "Absolute"
    },
    "session_settings.video.emulated_headset_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1248,
        "height": {
          "set": true,
          "content": 1120
        }
      },
      "variant": "Absolute"
    }
  },
  "host": {
    "shim": true,
    "fps": 90,
    "seconds": 70,
    "connect_timeout": 45,
    "gpu_keepalive": 90,
    "exit_after_frames": 100000,
    "running_start_ms": 2.0,
    "frame_gen": "on",
    "env": {
      "AIRFRAMEXR_FG_SYNTH": "neural"
    }
  },
  "client": {
    "seconds": 75,
    "connect_timeout": 45,
    "yaw_amp": 0.5,
    "yaw_hz": 0.25,
    "display_sim": true,
    "poll_ms": 5,
    "queue_max": 2,
    "motion": "yaw"
  },
  "client_env": {
    "RUST_LOG": "warn"
  },
  "app": {
    "frames": 1800,
    "timeout_s": 60,
    "env": {
      "XR_PROBE_CPU_MS": "1",
      "XR_PROBE_GPU_COPIES": "0",
      "XR_PROBE_LOAD": "fps:50:70"
    }
  },
  "gpu_sample": true,
  "timeout_s": 220,
  "checks": {
    "host_min_frames": 600,
    "client_min_frames": 600,
    "game_run": {
      "max_latency_ms": 200,
      "max_latency_outliers": 0
    },
    "max_duplicate_timestamps": 10,
    "fg": {
      "frame": [
        2496,
        1120
      ],
      "synth_share": [
        0.4,
        0.6
      ],
      "min_stream_fps_frac": 0.95,
      "synth_ms_per_mpx": [
        0.005,
        0.1
      ],
      "neural": true
    }
  }
}
