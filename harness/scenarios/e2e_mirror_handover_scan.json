{
  "description": "The mirror does not depend on the shim's event: with the event ignored (--ignore-signal) every mirror still leaves within 3 s when another app has the OpenXR runtime loaded, and a mirror started while an app runs waits for it to leave before taking the headset. Covers a game that touches OpenXR early (console, launcher stage) and opens its session later, which the one-shot event can miss (field report stillhappens2).",
  "topology": {
    "host": "builder",
    "client": "builder",
    "client_bind_ip": "127.0.0.2",
    "host_launch": "interactive"
  },
  "session_overrides": {
    "session_settings.video.foveated_encoding.enabled": false,
    "openvr_config.enable_foveated_encoding": false,
    "openvr_config.eye_resolution_width": 1760,
    "openvr_config.eye_resolution_height": 1600,
    "openvr_config.target_eye_resolution_width": 1760,
    "openvr_config.target_eye_resolution_height": 1600,
    "session_settings.connection.client_recv_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.connection.server_send_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.video.transcoding_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    },
    "session_settings.video.emulated_headset_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    }
  },
  "host": {
    "shim": true,
    "fps": 90,
    "seconds": 90,
    "connect_timeout": 45,
    "gpu_keepalive": 90
  },
  "client": {
    "seconds": 85,
    "connect_timeout": 45,
    "yaw_amp": 0,
    "controllers": true
  },
  "client_env": {
    "RUST_LOG": "warn",
    "MOCK_HAND_YAW_DEG": "0",
    "MOCK_HAND_PITCH_DEG": "45"
  },
  "app": {
    "exe": "mirrordesktop",
    "seconds": 90,
    "timeout_s": 100,
    "synthetic": true,
    "ignore_signal": true,
    "then": [
      {
        "exe": "xr_probe",
        "after_s": 10,
        "frames": 900,
        "timeout_s": 60
      },
      {
        "exe": "mirrordesktop",
        "after_s": 3,
        "seconds": 60
      },
      {
        "exe": "xr_probe",
        "after_s": 22,
        "frames": 300,
        "timeout_s": 60
      }
    ]
  },
  "gpu_sample": true,
  "timeout_s": 360,
  "checks": {
    "max_duplicate_timestamps": 10000,
    "min_delivery_ratio": 0.3,
    "codec": "Hevc",
    "decode": false,
    "timestamps_monotonic": false,
    "handover_chain": {
      "max_leave_s": 3.0,
      "via_scan": true,
      "min_wait_s": 3.0
    }
  }
}
