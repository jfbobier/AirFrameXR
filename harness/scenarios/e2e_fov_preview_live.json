{
  "description": "The live preview knob (docs/PICTURE_EDGES_DESIGN.md sections 6, 6b; host stdin `fov_preview on <outer inner upper lower>`, ipc previewOn / previewBox, shim ApplyPreviewMask): the game is told the whole Vision Pro panel and renders all of it, and the host is asked to preview the author's fit one second after it starts. The decoded stream must be black outside the preview box and carry the picture inside it, with nothing re-told to the game (its FOV and size stay the panel's): the mechanism the fit and restriction tools and the Advanced window's live preview over a running game use.",
  "topology": {
    "host": "builder",
    "client": "builder",
    "client_bind_ip": "127.0.0.2",
    "host_launch": "interactive"
  },
  "session_overrides": {
    "session_settings.video.foveated_encoding.enabled": false,
    "openvr_config.enable_foveated_encoding": false,
    "openvr_config.eye_resolution_width": 1760,
    "openvr_config.eye_resolution_height": 1600,
    "openvr_config.target_eye_resolution_width": 1760,
    "openvr_config.target_eye_resolution_height": 1600,
    "session_settings.connection.client_recv_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.connection.server_send_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.video.transcoding_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    },
    "session_settings.video.emulated_headset_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    }
  },
  "host": {
    "shim": true,
    "fps": 90,
    "seconds": 60,
    "connect_timeout": 45,
    "gpu_keepalive": 90,
    "exit_after_frames": 420,
    "gui": true
  },
  "client": {
    "seconds": 55,
    "connect_timeout": 45,
    "yaw_amp": 0.5,
    "yaw_hz": 0.25,
    "views_tan": "1.732,1.0,1.192,1.0"
  },
  "client_env": {
    "RUST_LOG": "warn"
  },
  "app": {
    "frames": 420,
    "timeout_s": 60
  },
  "gpu_sample": true,
  "timeout_s": 200,
  "checks": {
    "host_min_frames": 250,
    "client_min_frames": 200,
    "timestamps_monotonic": true,
    "max_duplicate_timestamps": 400,
    "min_delivery_ratio": 0.7,
    "codec": "Hevc",
    "stream": {
      "codec_name": "hevc",
      "profile": "Main 10",
      "pix_fmt": "yuv420p10le",
      "width": 3520,
      "height": 1600,
      "color_range": "pc"
    },
    "decode": true,
    "decode_frame_slack": 40,
    "app_min_frames": 300,
    "pose_roundtrip_max_rad": 0.06,
    "min_yaw_range_rad": 0.3,
    "refresh_hz": 90,
    "max_pipeline_latency_ms": 150,
    "fov_restrict": {
      "scale": [
        100,
        100,
        100,
        100
      ],
      "tol": 0.002,
      "preview": [
        0.97,
        0.71,
        0.69,
        0.63
      ]
    }
  },
  "stdin_feed": {
    "events": [
      {
        "t": 1,
        "line": "fov_preview on 0.97 0.71 0.69 0.63"
      }
    ],
    "hold_s": 600
  }
}
