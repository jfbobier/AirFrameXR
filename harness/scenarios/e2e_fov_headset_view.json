{
  "description": "Step C: the headset view V (docs/PICTURE_EDGES_DESIGN.md section 8). The host is told `headset_view on 1.2 0.8 0.9 0.8` (stdin, one second in) and sends {\"airframexr\":1,\"view\":...} to the client over ServerControlPacket::Reserved (tools/patches/headset-view-message.patch); the mock headset (client-reserved-message.patch) panel is Apple's frustum, declares min(panel, V) per eye after its first frame, so the host's views_config and the box the game is told are V, not the panel.",
  "topology": {
    "host": "builder",
    "client": "builder",
    "client_bind_ip": "127.0.0.2",
    "host_launch": "interactive"
  },
  "session_overrides": {
    "session_settings.video.foveated_encoding.enabled": false,
    "openvr_config.enable_foveated_encoding": false,
    "openvr_config.eye_resolution_width": 1760,
    "openvr_config.eye_resolution_height": 1600,
    "openvr_config.target_eye_resolution_width": 1760,
    "openvr_config.target_eye_resolution_height": 1600,
    "session_settings.connection.client_recv_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.connection.server_send_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.video.transcoding_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    },
    "session_settings.video.emulated_headset_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    }
  },
  "host": {
    "shim": true,
    "fps": 90,
    "seconds": 60,
    "connect_timeout": 45,
    "gpu_keepalive": 90,
    "exit_after_frames": 420,
    "gui": true
  },
  "client": {
    "seconds": 55,
    "connect_timeout": 45,
    "yaw_amp": 0.5,
    "yaw_hz": 0.25,
    "views_tan": "1.732,1.0,1.192,1.0",
    "views_after_first_frame": true
  },
  "client_env": {
    "RUST_LOG": "warn"
  },
  "app": {
    "frames": 420,
    "timeout_s": 60
  },
  "gpu_sample": true,
  "timeout_s": 200,
  "checks": {
    "host_min_frames": 250,
    "client_min_frames": 200,
    "timestamps_monotonic": true,
    "max_duplicate_timestamps": 400,
    "min_delivery_ratio": 0.7,
    "codec": "Hevc",
    "stream": {
      "codec_name": "hevc",
      "profile": "Main 10",
      "pix_fmt": "yuv420p10le",
      "width": 3520,
      "height": 1600,
      "color_range": "pc"
    },
    "decode": true,
    "decode_frame_slack": 40,
    "app_min_frames": 300,
    "pose_roundtrip_max_rad": 0.06,
    "min_yaw_range_rad": 0.3,
    "refresh_hz": 90,
    "max_pipeline_latency_ms": 150,
    "fov_restrict": {
      "scale": [
        100,
        100,
        100,
        100
      ],
      "tol": 0.002,
      "declared": [
        1.2,
        0.8,
        0.9,
        0.8
      ]
    }
  },
  "stdin_feed": {
    "events": [
      {
        "t": 1,
        "line": "headset_view on 1.2 0.8 0.9 0.8"
      }
    ],
    "hold_s": 600
  }
}
